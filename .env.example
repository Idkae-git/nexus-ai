# AniList OAuth application created at https://anilist.co/settings/developer
# Redirect URI must exactly match the application setting.
NEXUS_ANILIST_CLIENT_ID=
NEXUS_ANILIST_CLIENT_SECRET=
NEXUS_ANILIST_REDIRECT_URI=nexus://oauth/anilist

# Simkl application created at https://simkl.com/settings/developer/
NEXUS_SIMKL_CLIENT_ID=
NEXUS_SIMKL_REDIRECT_URI=nexus://oauth/simkl
